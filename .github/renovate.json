{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "description": "Schedule to run on weekends",
  "schedule": [
    "* * * * 0,6"
  ],
  "packageRules": [
    {
      "groupName": "Update other dependencies",
      "matchPackageNames": [
        "*"
      ],
      "automerge": true
    },
    {
      "groupName": "Update Androidx",
      "matchPackageNames": [
        "/androidx.*/"
      ],
      "automerge": true
    },
    {
      "groupName": "kotlin",
      "matchPackageNames": [
        "/androidx.compose.compiler:compiler/"
      ],
      "automerge": true
    },
    {
      "groupName": "kotlin",
      "matchPackageNames": [
        "/org.jetbrains.kotlin.*/"
      ],
      "automerge": true
    }
  ]
}